# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key (or Maps Demo Key).
# If not provided, an interactive high-resolution SVG/Leaflet fallback map is displayed with all 21 LGAs, wards, and streets.
VITE_GOOGLE_MAPS_API_KEY=""

# ============================================================================
# SERVER-SIDE ONLY: PAYSTACK & VTU PROVIDER CREDENTIALS
# Never expose secret keys in VITE_* frontend variables.
# If left empty, the application automatically runs in DEMO / TEST PAYMENT MODE.
# ============================================================================
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# VTU Provider selection: "sandbox" | "vtung" | "reloadly" | "flutterwave"
VTU_PROVIDER="sandbox"
VTU_API_KEY=""
VTU_API_SECRET=""
VTU_BASE_URL=""

