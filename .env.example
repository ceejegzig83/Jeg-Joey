# ============================================================================
# FLOURISH DESTINY COLLECTION — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit real secrets or .env.local to version control.
# If production credentials are omitted, the application automatically runs
# in DEMO / TEST MODE without crashing.
# ============================================================================

NODE_ENV="development"
PORT="3000"

# ============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# Leave empty to use the built-in Demo/Test Persistent Database Layer
# ============================================================================
DATABASE_URL=""

# ============================================================================
# 2. AUTHENTICATION & SECURITY (Server-Side Only)
# ============================================================================
JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ============================================================================
# 3. PAYSTACK PAYMENT GATEWAY (Server-Side Secret + Public Key)
# Never expose PAYSTACK_SECRET_KEY in VITE_* frontend variables.
# ============================================================================
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""

# ============================================================================
# 4. NIGERIAN VTU PROVIDER (Airtime & Mobile Data — Server-Side Only)
# Supported VTU_PROVIDER values: "sandbox" | "vtung" | "reloadly" | "flutterwave"
# ============================================================================
VTU_PROVIDER="sandbox"
VTU_API_KEY=""
VTU_API_SECRET=""
VTU_BASE_URL=""

# ============================================================================
# 5. GOOGLE MAPS & GEOLOCATION
# ============================================================================
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# ============================================================================
# 6. AI STUDIO RUNTIME (Optional)
# ============================================================================
GEMINI_API_KEY=""



